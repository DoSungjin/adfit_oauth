# ===================================
# AdFit OAuth Server 환경 변수 설정
# ===================================
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요
# cp .env.example .env

# 서버 설정
PORT=8080
ENVIRONMENT=production

# Firebase 설정
FIREBASE_PROJECT_ID=your-firebase-project-id

# ===================================
# OAuth 설정
# ===================================

# TikTok OAuth
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://your-server.run.app/api/tiktok/callback

# YouTube OAuth (로그인용)
YOUTUBE_CLIENT_ID=your-youtube-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# ===================================
# API Keys
# ===================================

# YouTube Data API v3 키 (Browser Key) - 통계 조회용
YOUTUBE_API_KEY=your-youtube-api-key

# ===================================
# 보안 설정
# ===================================

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key

# 통계 업데이트 인증 토큰
STATS_UPDATE_TOKEN=your-stats-update-token

# ===================================
# 클라이언트 설정
# ===================================

# 클라이언트 리다이렉트 URL
CLIENT_REDIRECT_URL=https://your-domain.ai/auth/callback/tiktok

# ===================================
# 기능 플래그
# ===================================

# Firestore/Realtime DB 업데이트 설정
ENABLE_FIRESTORE_UPDATE=true
ENABLE_REALTIME_UPDATE=true
